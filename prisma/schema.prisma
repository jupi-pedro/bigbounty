generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or mysql/sqlite/etc.
  url      = env("DATABASE_URL")
}

enum Role {
  Administrator
  Moderator
  Viewer
  Developer
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role      @default(Developer)

  jobLinks JobLink[]
  dailyReports DailyReport[]
}

model JobLink {
  id          String  @id @default(cuid())
  jobTitle    String
  link        String
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  jobLinkSourceId String
  jobLinkSource   JobLinkSource @relation(fields: [jobLinkSourceId], references: [id])
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobLinks JobLink[]
}

model JobLinkSource {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobLinks JobLink[]
}

model DailyReport {
  id      String   @id @default(cuid())

  userId  String
  user    User     @relation(fields: [userId], references: [id])

  date    DateTime
  content String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // Ensures only one report per user per date
}
