generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or mysql/sqlite/etc.
  url      = env("DATABASE_URL")
}

enum Role {
  Administrator
  Moderator
  Viewer
  Developer
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role      @default(Developer)

  jobLinks JobLink[]
  dailyReports DailyReport[]
  sessions UserSession[]
}

model JobLink {
  id          String  @id @default(cuid())
  jobTitle    String
  link        String
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  jobLinkSourceId String
  jobLinkSource   JobLinkSource @relation(fields: [jobLinkSourceId], references: [id])
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobLinks JobLink[]
}

model JobLinkSource {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobLinks JobLink[]
}

model DailyReport {
  id      String   @id @default(cuid())

  userId  String
  user    User     @relation(fields: [userId], references: [id])

  date    DateTime
  content String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // Ensures only one report per user per date
}

model UserSession {
  id         String   @id @default(cuid())
  sessionId  String?  @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  
  ipAddress  String
  userAgent  String   @db.Text
  lastActive DateTime @default(now())
  expiresAt  DateTime
  isActive   Boolean  @default(true)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([sessionId])
}

model InterviewProcess {
  id             String   @id @default(cuid())
  jobTitle       String
  company        String
  identity       String
  person         String
  jobDescription   String?  @db.Text
  interviewDetails String?  @db.Text
  status           String   @default("In Progress") // In Progress, Offered, Declined, Withdrawn
  expectedSteps    Int?     // Expected number of interview steps (nullable)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  interviewSteps InterviewStep[]
}

model InterviewStep {
  id                  String   @id @default(cuid())
  type                String   // Assessment, Phone Call, Video Call
  title               String
  date                DateTime @db.Date
  interviewerName     String?
  note                String?  @db.Text
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  interviewProcessId  String
  interviewProcess    InterviewProcess @relation(fields: [interviewProcessId], references: [id], onDelete: Cascade)
}
